(3, 'express', 'Shipping Discount / 运费折扣', 'Shipping Discount', '/uploads/system/55f5518b80f35386bc7224cfb1ee3700.png', '10% off shipping / 运费 9 折', 90, 0, 1, 0),
(4, 'sign', 'Daily Check-in Bonus / 签到返利', 'Check-in Bonus', '/uploads/system/b56f2bc3e92ddf7e306bdd228fae1993.png', 'Earn 3x points on daily check-in / 签到 3 倍积分', 3, 0, 1, 0),
(5, 'offline', 'In-store Discount / 线下折扣', 'In-store Discount', '/uploads/system/15ed21e8b1a3eacbac52c30bf8a82bc4.png', '10% off in-store / 线下 9 折', 90, 0, 0, 0),
(6, 'coupon', 'Monthly Coupon / 会员优惠券', 'Monthly Coupon', '/uploads/system/47c6046274318574a4840ad4f4c566f1.png', 'Get $3 coupon every month / 每月领 $3 会员券', 1, 0, 1, 0);

