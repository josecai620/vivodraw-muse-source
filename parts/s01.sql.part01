(22, 0, 'wechat_share_synopsis', 'textarea', '', 72, '', 0, '', 100, 5, '\"CRMEB_PRO\\u6700\\u65b0\\u7248\\u672c\\u4e0a\\u7ebf\\u5566\\uff01\\u8d76\\u5feb\\u9886\\u53d6\\u5427\\uff01\"', '分享简介', '', 0, 1),
