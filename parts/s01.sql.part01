--
-- 表的结构 `eb_store_product_ensure`
--

CREATE TABLE IF NOT EXISTS `eb_store_product_ensure` (
    `id` int(11) NOT NULL AUTO_INCREMENT,
    `type` TINYINT(1) NULL DEFAULT '1' COMMENT '类型：1平台2:门店',
    `store_id` INT(11) NOT NULL DEFAULT '0' COMMENT '门店ID',
    `name` varchar(255) NOT NULL DEFAULT '' COMMENT '标签名称',
    `image` varchar(255) NOT NULL DEFAULT '' COMMENT '图片',
    `desc` varchar(255) NOT NULL DEFAULT '' COMMENT '描述',
    `sort` int(10) NOT NULL DEFAULT '0' COMMENT '排序',
    `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
    `add_time` int(10) NOT NULL DEFAULT '0' COMMENT '添加时间',
    PRIMARY KEY (`id`),
    KEY `store_id` (`store_id`),
    KEY `type` (`type`)
    ) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8mb4 COMMENT='商品保障服务表';


