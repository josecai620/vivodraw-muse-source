-- 表的结构 `eb_store_product_label_auxiliary`
--

CREATE TABLE IF NOT EXISTS `eb_store_product_label_auxiliary` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `label_id` int(11) NOT NULL DEFAULT '0',
