(18, 3, '购买方式', '公开版,换修无忧月付版,换修无忧年付版', 0),
(19, 2, '颜色', '深空灰,银色,金色', 0),
(20, 2, '版本', '新款八核M1芯片8G 256G,新款八核M1芯片8G 512G,新款八核M1芯片16G 256G', 0),
