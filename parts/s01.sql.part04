SET FOREIGN_KEY_CHECKS = 1;


-- ============================================================
-- 第 3 段 / 4：盲盒概率与回收需要的列（旧库没有，仓库里也无迁移脚本）
-- ============================================================

-- 补列-盲盒概率与回收.sql
-- 用途：2025-06 备份（275 表）里缺这些列，而代码已经在用它们；
--       全仓 SQL 脚本没有任何一个建过这些列（当年在生产库上手工加的）。
-- 适用：MySQL 8.0，库前缀 eb_
-- 用法：在 crmeb.sql（或旧备份）之后执行一次；已存在的列会报 Duplicate column，可忽略该条。
-- 类型为依据代码用法推定的最小可用类型（精度需求更高请自行放大）。

-- 1. 盲盒分类（盒子）的稀有度权重：代码读 cate.tag1..tag6（MangheController.php:710）
--    旧库已有 tag1..tag4，缺 tag5 / tag6；tag5/tag6 都为 0 时 hasPublicOddsConfig() 判定"未启用公开概率"
ALTER TABLE `eb_store_category`
  ADD COLUMN `tag5` decimal(10,3) NOT NULL DEFAULT '0.000' COMMENT '稀有度权重 Legendary',
  ADD COLUMN `tag6` decimal(10,3) NOT NULL DEFAULT '0.000' COMMENT '稀有度权重 Secret';

-- 2. 商品（奖品）的回收字段：代码 SELECT is_recovery,recovery_price,reference_price,recovery_discount（MangheController.php:603）
--    回收价优先级：recovery_price > cost > price*recoveryRateByTag(tag)（:2580-2587）
ALTER TABLE `eb_store_product`
  ADD COLUMN `is_recovery` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否可回收',
  ADD COLUMN `recovery_price` decimal(12,2) NOT NULL DEFAULT '0.00' COMMENT '回收价（0 则按成本/比例算）',
  ADD COLUMN `reference_price` decimal(12,2) NOT NULL DEFAULT '0.00' COMMENT '参考价（展示用）',
  ADD COLUMN `recovery_discount` decimal(5,2) NOT NULL DEFAULT '0.00' COMMENT '回收折扣系数';

-- 3. 校验：确认列都在
-- SELECT COLUMN_NAME FROM information_schema.COLUMNS
--  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME='eb_store_category' AND COLUMN_NAME LIKE 'tag%';
-- SELECT COLUMN_NAME FROM information_schema.COLUMNS
--  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME='eb_store_product'
--    AND COLUMN_NAME IN ('is_recovery','recovery_price','reference_price','recovery_discount');


-- ============================================================
-- 第 4 段 / 4：盲盒签到/心愿单/兑换/合成 + 新手活动 + 结算账本
-- ============================================================

-- 盲盒商城新功能表 — 签到/心愿池/交换市场/合成
-- 执行前请确认数据库连接正确
-- 2026-03-18

-- 1. 每日签到记录
CREATE TABLE IF NOT EXISTS `eb_user_box_checkin` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '用户ID',
  `checkin_date` date NOT NULL COMMENT '签到日期',
  `streak` int(11) unsigned NOT NULL DEFAULT 1 COMMENT '当前连续签到天数',
  `reward_points` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '获得积分',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_uid_date` (`uid`, `checkin_date`),
  KEY `idx_uid` (`uid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒签到记录';

-- 2. 心愿池
CREATE TABLE IF NOT EXISTS `eb_user_box_wishlist` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '用户ID',
  `box_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '盲盒分类ID(store_category.id)',
  `box_name` varchar(255) NOT NULL DEFAULT '' COMMENT '盲盒名称',
  `item_name` varchar(255) NOT NULL DEFAULT '' COMMENT '心愿物品名称',
  `item_image` varchar(500) NOT NULL DEFAULT '' COMMENT '物品图片',
  `rarity` varchar(50) NOT NULL DEFAULT 'legendary' COMMENT '稀有度(common/uncommon/rare/epic/legendary/secret)',
  `notify` tinyint(1) unsigned NOT NULL DEFAULT 1 COMMENT '是否通知 0=否 1=是',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_uid` (`uid`),
  KEY `idx_box_id` (`box_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒心愿池';

-- 3. 交换市场
CREATE TABLE IF NOT EXISTS `eb_user_box_exchange` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '发布人ID',
  `user_box_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '挂出的盲盒物品ID(user_box.id)',
  `product_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '商品ID(store_product.id)',
  `item_name` varchar(255) NOT NULL DEFAULT '' COMMENT '物品名称',
  `item_image` varchar(500) NOT NULL DEFAULT '' COMMENT '物品图片',
  `item_rarity` varchar(50) NOT NULL DEFAULT '' COMMENT '物品稀有度',
  `want_desc` varchar(500) NOT NULL DEFAULT '' COMMENT '想要换取的物品描述',
  `want_rarity` varchar(50) NOT NULL DEFAULT '' COMMENT '想要换取的稀有度',
  `status` tinyint(1) unsigned NOT NULL DEFAULT 0 COMMENT '0=上架 1=交换中 2=已完成 3=已取消',
  `applicant_uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '申请人UID',
  `applicant_box_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '申请人提供的物品ID(user_box.id)',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  `updatetime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_uid` (`uid`),
  KEY `idx_status` (`status`),
  KEY `idx_user_box_id` (`user_box_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒交换市场';

-- 4. 合成记录
CREATE TABLE IF NOT EXISTS `eb_user_box_synthesis_log` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '用户ID',
  `recipe_type` varchar(50) NOT NULL DEFAULT '' COMMENT '配方类型(common_to_uncommon等)',
  `material_ids` text COMMENT '材料盲盒IDs(JSON数组)',
  `result_success` tinyint(1) unsigned NOT NULL DEFAULT 0 COMMENT '0=失败 1=成功',
  `result_product_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '合成结果商品ID',
  `result_item_name` varchar(255) NOT NULL DEFAULT '' COMMENT '合成结果物品名称',
  `result_item_image` varchar(500) NOT NULL DEFAULT '' COMMENT '合成结果物品图片',
  `result_rarity` varchar(50) NOT NULL DEFAULT '' COMMENT '合成结果稀有度',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_uid` (`uid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒合成记录';

-- 5. 每日任务领取记录
CREATE TABLE IF NOT EXISTS `eb_user_box_task_claim` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '用户ID',
  `task_id` varchar(50) NOT NULL DEFAULT '' COMMENT '任务ID',
  `claim_date` date NOT NULL COMMENT '领取日期',
  `reward_points` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '获得积分',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_uid_task_date` (`uid`, `task_id`, `claim_date`),
  KEY `idx_uid` (`uid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒每日任务领取记录';

-- 盲盒商城 Phase 2 — 限时活动/新人礼包
-- 2026-03-18

-- 1. 限时活动
CREATE TABLE IF NOT EXISTS `eb_box_activity` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL DEFAULT '' COMMENT '活动标题',
  `description` text COMMENT '活动描述',
  `cate_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '关联盲盒分类ID',
  `boost_type` varchar(50) NOT NULL DEFAULT 'rarity_up' COMMENT '提升类型(rarity_up/discount/bonus)',
  `boost_value` decimal(10,2) NOT NULL DEFAULT 0 COMMENT '提升值(概率倍数/折扣比/赠送积分)',
  `banner_image` varchar(500) NOT NULL DEFAULT '' COMMENT '活动Banner图',
  `start_time` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '开始时间',
  `end_time` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '结束时间',
  `status` tinyint(1) unsigned NOT NULL DEFAULT 1 COMMENT '0=关闭 1=开启',
  `sort` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '排序',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_time` (`start_time`, `end_time`),
  KEY `idx_cate_id` (`cate_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒限时活动';

-- 2. 新人礼包领取记录
CREATE TABLE IF NOT EXISTS `eb_user_box_newbie` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '用户ID',
  `reward_type` varchar(50) NOT NULL DEFAULT 'free_box' COMMENT '奖励类型',
  `reward_points` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '赠送积分',
  `reward_box_order_id` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '赠送盲盒订单ID',
  `createtime` int(11) unsigned NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_uid` (`uid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='盲盒新人礼包领取记录';

-- 插入一条默认限时活动（示例，可通过后台管理修改）
INSERT INTO `eb_box_activity` (`title`, `description`, `boost_type`, `boost_value`, `start_time`, `end_time`, `status`, `sort`, `createtime`)
VALUES ('新用户限时福利', '注册7天内开盒，稀有概率翻倍！', 'rarity_up', 2.00, UNIX_TIMESTAMP(), UNIX_TIMESTAMP() + 604800, 1, 100, UNIX_TIMESTAMP());

-- 签到核心结算审计日志表
-- Execution: CREATE TABLE IF NOT EXISTS ...
-- 2026-05-18

CREATE TABLE IF NOT EXISTS `eb_core_settlement_ledger` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `scene` varchar(64) NOT NULL DEFAULT '' COMMENT '场景：user_checkin / pet_feeding',
  `action` varchar(64) NOT NULL DEFAULT '' COMMENT '操作：daily_checkin / pet_feed',
  `uid` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '用户ID',
  `request_id` varchar(128) NOT NULL DEFAULT '' COMMENT '幂等请求ID',
  `amount` int(11) NOT NULL DEFAULT 0 COMMENT '积分变动量',
  `direction` tinyint(1) unsigned NOT NULL DEFAULT 1 COMMENT '方向：1=收入 0=支出',
  `reason` varchar(64) NOT NULL DEFAULT '' COMMENT '原因：checkin_integral / pet_feed_cost 等',
  `meta` text DEFAULT NULL COMMENT '额外元数据(JSON)',
  `add_time` int(11) unsigned NOT NULL DEFAULT 0 COMMENT '创建时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_request_id` (`scene`, `request_id`),
  KEY `idx_uid` (`uid`),
  KEY `idx_add_time` (`add_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='核心结算审计日志';


